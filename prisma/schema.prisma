generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Gallery {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  date       String
  status     String   @default("draft")
  created_at DateTime @default(now())
}

model Booking {
  id           String   @id @default(uuid())
  client_id    String?
  name         String?
  package_type String
  event_date   String
  amount       Float
  advance_paid Float
  status       String   @default("pending")
  created_at   DateTime @default(now())
}
